# Bu dosyayi .env olarak kopyalayip kendi (ucretsiz) API anahtarlarinla doldur.
# Hicbir anahtar girmezsen Zenith sadece yerel Ollama modelleriyle calisir.

# https://console.groq.com/keys (ucretsiz, cok hizli)
GROQ_API_KEY=

# https://aistudio.google.com/apikey (ucretsiz katman)
GEMINI_API_KEY=

# https://openrouter.ai/keys (":free" ekli onlarca ucretsiz model)
OPENROUTER_API_KEY=

# https://cloud.cerebras.ai (ucretsiz katman)
CEREBRAS_API_KEY=

# Ollama varsayilan olarak http://localhost:11434 adresini kullanir.
# Farkli bir host/port kullaniyorsan asagidakini ac:
# OLLAMA_HOST=http://localhost:11434
