# Bu dosyayi .env olarak kopyalayip kendi (ucretsiz) API anahtarlarinla doldur.
# Hicbir anahtar girmezsen Zenith sadece yerel Ollama modelleriyle calisir.

# ONERILEN: https://openrouter.ai/keys
# Tek anahtarla ":free" etiketli onlarca acik kaynak model:
# Hermes 3 405B, DeepSeek V3/R1, Llama 4, Qwen3, Kimi K2, GLM 4.5, gpt-oss...
OPENROUTER_API_KEY=

# GitHub hesabin varsa ekstra kayit gerektirmez:
# https://github.com/settings/tokens -> "Generate new token" -> "models:read" izni
# GPT-4o-mini, DeepSeek-R1, Llama 3.3, Phi-4 ucretsiz (GitHub Models).
GITHUB_API_KEY=

# https://aistudio.google.com/apikey (ucretsiz katman)
GEMINI_API_KEY=

# https://console.mistral.ai (ucretsiz deney katmani)
MISTRAL_API_KEY=

# https://cloud.cerebras.ai (ucretsiz katman, cok hizli)
CEREBRAS_API_KEY=

# Istege bagli: https://console.groq.com/keys
GROQ_API_KEY=

# Ollama varsayilan olarak http://localhost:11434 adresini kullanir.
# Farkli bir host/port icin: OLLAMA_HOST=http://localhost:11434
# Hermes'i yerelde calistirmak icin: ollama pull hermes3

# Istege bagli ozellestirmeler:
# ZENITH_SYSTEM_PROMPT="kendi Jarvis kisiligini buraya yaz"
# ZENITH_MEMORY_PATH=/baska/bir/yol/memory.json
# ZENITH_DISABLE_OLLAMA=1
