# ============================================================================
# ZENITH CONFIGURATION
# ============================================================================

# API Keys (at least one required for models)
# OpenRouter: recommended (single key for many free models)
OPENROUTER_API_KEY=your_openrouter_key_here

# GitHub Models (GitHub account required, free tier)
GITHUB_API_KEY=your_github_token_here

# Google Gemini (free tier)
GEMINI_API_KEY=your_gemini_key_here

# Mistral La Plateforme (free tier)
MISTRAL_API_KEY=your_mistral_key_here

# Cerebras (fast inference)
CEREBRAS_API_KEY=your_cerebras_key_here

# Groq (optional)
GROQ_API_KEY=your_groq_key_here

# ============================================================================
# STORAGE PATHS (optional, defaults to ~/.zenith/)
# ============================================================================

# ZENITH_MEMORY_PATH=/path/to/memory.json
# ZENITH_NOTES_PATH=/path/to/notes.json
# ZENITH_PROFILE_PATH=/path/to/profile.json
# ZENITH_DOCS_PATH=/path/to/docs.json
# ZENITH_CACHE_PATH=/path/to/cache.json
# ZENITH_ANALYTICS_PATH=/path/to/analytics.json

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

# System prompt (optional, defaults to Turkish-friendly assistant personality)
# ZENITH_SYSTEM_PROMPT="You are Zenith, a personal AI assistant..."

# Disable Ollama in serverless environments
# ZENITH_DISABLE_OLLAMA=true

# Logging configuration
# ZENITH_LOG_LEVEL=INFO
# ZENITH_LOG_FILE=/path/to/zenith.log

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Web server port
PORT=8000

# Enable CORS
CORS_ORIGINS=*

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable council mode by default
ZENITH_COUNCIL_ENABLED=false

# Enable/disable agent mode by default
ZENITH_AGENT_ENABLED=false

# Max concurrent requests
ZENITH_MAX_CONCURRENT=5

# Cache TTL (hours)
ZENITH_CACHE_TTL=24

# ============================================================================
# ADVANCED
# ============================================================================

# Vercel deployment detection (auto-set in Vercel)
# VERCEL=true
