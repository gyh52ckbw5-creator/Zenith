# Bu dosyayi ".env" adiyla KOPYALA ve kendi degerlerini yaz:
#   cp .env.example .env
# .env dosyasi .gitignore'dadir, asla git'e/GitHub'a gitmez.
# Bu ornek dosyaya GERCEK deger yazma!

# Telegram bildirimleri (@BotFather'dan alinir; kurulum: bot/notify.py basinda)
TELEGRAM_BOT_TOKEN=123456789:ornek-token-buraya
TELEGRAM_CHAT_ID=123456789

# Binance API (sadece testnet/live icin gerekir; testnet: testnet.binance.vision)
# Anahtar olustururken SADECE "spot trade" izni ver, para cekme iznini ACMA.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Ucretsiz AI yorumcu (istege bagli): https://openrouter.ai -> Keys
# OPENROUTER_API_KEY=
# AI_MODEL=deepseek/deepseek-chat-v3-0324:free
